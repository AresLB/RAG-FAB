# Environment Configuration
NODE_ENV=development
PORT=3001

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# MongoDB (Vercel automatically creates this when using Vercel Storage MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=rag-fab

# RAG Configuration (Optional - has smart defaults)
# HYBRID_SEARCH_ENABLED=true  # Enable hybrid search (BM25 + semantic), default: true
# BM25_WEIGHT=0.5  # Weight for keyword search (0-1), default: 0.5
# SEMANTIC_WEIGHT=0.5  # Weight for semantic search (0-1), default: 0.5

# Google OAuth (Gmail API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (Outlook API)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=rag-fab-documents

# Stripe (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
